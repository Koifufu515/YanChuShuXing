              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "metrics": {
            "properties": {
              "source_metric_ids": {
                "type": "array",
                "minItems": 2
              }
            },
            "required": [
              "source_metric_ids"
            ]
          }
        },
        "required": [
          "metrics"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "contains": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "metric_completeness"
                }
              },
              "required": [
                "type"
              ]
            },
            "minContains": 1
          }
        },
        "required": [
          "checks"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "properties": {
              "code": {
                "not": {
                  "const": "executable"
                }
              }
            },
            "required": [
              "code"
            ]
          }
        },
        "required": [
          "status"
