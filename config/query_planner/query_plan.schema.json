                  "properties": {
                    "metric_ids": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^ZB\\d{3}$"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_type",
        "result_fields",
        "unit",
        "rounding",
        "tie_policy"
      ],
      "properties": {
        "answer_type": {
          "type": "string",
          "enum": [
            "single_value",
            "comparison",
            "time_series",
            "ranking",
            "extreme_value",
            "boolean_with_difference",
            "threshold_assessment",
            "composite"
          ]
        },
        "result_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "rounding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "digits"
          ],
          "properties": {
            "mode": {
              "type": "string",
