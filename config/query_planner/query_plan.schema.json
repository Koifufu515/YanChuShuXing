                        "ascending",
                        "descending"
                      ]
                    }
                  }
                },
                "input_refs": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator_id": {
                  "const": "OP012"
                }
              },
              "required": [
                "operator_id"
              ]
            },
            "then": {
              "properties": {
                "parameters": {
                  "required": [
                    "metric_id",
                    "performance_direction"
                  ],
                  "properties": {
                    "metric_id": {
                      "type": "string",
                      "pattern": "^ZB\\d{3}$"
                    },
                    "performance_direction": {
                      "type": "string",
                      "enum": [
                        "higher_is_better",
                        "lower_is_better"
                      ]
                    }
                  }
                },
                "input_refs": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator_id": {
                  "const": "OP013"
                }
              },
              "required": [
                "operator_id"
              ]
            },
            "then": {
              "properties": {
                "input_refs": {
                  "minItems": 1,
                  "maxItems": 1
                },
                "parameters": {
                  "required": [
                    "n",
                    "direction"
                  ],
                  "properties": {
                    "n": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "direction": {
                      "type": "string",
                      "enum": [
                        "top",
                        "bottom"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator_id": {
                  "const": "OP015"
                }
              },
              "required": [
                "operator_id"
              ]
            },
            "then": {
              "properties": {
                "input_refs": {
                  "minItems": 1,
                  "maxItems": 1
                },
                "parameters": {
                  "required": [
                    "comparison_operator",
                    "threshold",
                    "unit"
                  ],
                  "properties": {
                    "comparison_operator": {
                      "type": "string",
                      "enum": [
                        ">",
                        ">=",
                        "<",
                        "<=",
                        "=",
                        "!="
                      ]
                    },
                    "threshold": {
                      "type": [
                        "number",
                        "integer"
                      ]
                    },
                    "unit": {
                      "type": "string"
                    }
                  },
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "condition"
                        ]
                      },
                      {
                        "required": [
                          "comparison"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator_id": {
                  "const": "OP016"
                }
              },
              "required": [
                "operator_id"
              ]
            },
            "then": {
              "properties": {
                "parameters": {
                  "required": [
                    "comparison_operator",
                    "threshold",
                    "unit"
                  ],
                  "properties": {
                    "comparison_operator": {
                      "type": "string",
                      "enum": [
                        ">",
                        ">=",
                        "<",
                        "<=",
                        "=",
                        "!="
                      ]
                    },
                    "threshold": {
                      "type": [
                        "number",
                        "integer"
                      ]
                    },
                    "unit": {
                      "type": "string"
                    }
                  },
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "condition"
                        ]
                      },
                      {
                        "required": [
                          "comparison"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator_id": {
                  "const": "OP019"
                }
              },
              "required": [
                "operator_id"
              ]
            },
            "then": {
              "properties": {
                "input_refs": {
                  "minItems": 2
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator_id": {
                  "const": "OP021"
                }
              },
              "required": [
                "operator_id"
              ]
            },
            "then": {
              "properties": {
                "parameters": {
                  "required": [
                    "type",
                    "reference_date"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "previous_month_end",
                        "previous_quarter_end",
                        "previous_year_same_period",
                        "previous_year_end",
                        "year_begin_base"
                      ]
                    },
                    "reference_date": {
                      "type": "string",
                      "format": "date"
                    }
                  }
                },
                "input_refs": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator_id": {
                  "const": "OP014"
                }
              },
              "required": [
                "operator_id"
              ]
            },
            "then": {
              "properties": {
                "input_refs": {
                  "minItems": 1,
                  "maxItems": 1
                },
                "parameters": {
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "max",
                        "min"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator_id": {
                  "const": "OP018"
                }
              },
              "required": [
                "operator_id"
              ]
            },
            "then": {
              "properties": {
                "input_refs": {
                  "minItems": 1,
                  "maxItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "parameters"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "record_exists",
              "institution_completeness",
              "date_completeness",
              "metric_completeness",
              "denominator_nonzero",
              "unit_consistency",
              "unrounded_comparison",
              "tie_preservation"
            ]
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true,
            "not": {
              "required": [
                "metric_id"
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "record_exists",
                    "metric_completeness",
                    "denominator_nonzero",
                    "unit_consistency",
                    "unrounded_comparison",
                    "tie_preservation"
                  ]
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "parameters": {
                  "required": [
