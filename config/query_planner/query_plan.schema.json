{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yanchushuxing.local/schemas/query-plan-v1.4.json",
  "title": "言出数行标准查询计划 v1.4",
  "description": "银行智能问数查询计划结构约束。统一多记录排序、跨期对齐、动态全省均值比较和普通除法契约。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "institutions",
    "metrics",
    "time",
    "operations",
    "checks",
    "output"
  ],
  "properties": {
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "reason",
        "clarification_question"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "executable",
            "clarification_required",
            "pending_project_definition",
            "data_unavailable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "clarification_question": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "institutions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets",
        "comparison_population"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "institution_id",
              "role"
            ],
            "properties": {
              "institution_id": {
                "type": "string",
                "pattern": "^ORG\\d{3}$"
              },
              "role": {
                "type": "string",
                "enum": [
                  "target",
                  "left_operand",
                  "right_operand"
                ]
              }
            }
          },
          "uniqueItems": true
        },
        "comparison_population": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "institution_ids"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "none",
                "explicit",
                "all_official_institutions"
              ]
            },
            "institution_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^ORG\\d{3}$"
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_metric_ids",
        "source_metric_ids",
        "concept_ids"
      ],
      "properties": {
        "requested_metric_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ZB\\d{3}$"
          },
          "uniqueItems": true
        },
        "source_metric_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ZB\\d{3}$"
          },
          "uniqueItems": true
        },
        "concept_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^BC\\d{3}$"
          },
          "uniqueItems": true
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "dates",
        "start_date",
        "end_date",
        "grain",
        "comparison_periods"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "point",
            "range",
            "series",
            "comparison"
          ]
        },
        "dates": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date"
          },
          "uniqueItems": true
        },
        "start_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "end_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "grain": {
          "type": "string",
          "enum": [
            "day",
            "month_end",
            "quarter_end",
            "year_end"
          ]
        },
        "comparison_periods": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "date",
              "start_date",
              "end_date"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "explicit",
                  "previous_day",
                  "previous_month_end",
                  "previous_quarter_end",
                  "previous_year_same_period",
                  "year_beginning"
                ]
              },
              "date": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "start_date": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "end_date": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              }
            }
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "operator_id",
          "input_refs",
          "output_ref",
          "parameters"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "operator_id": {
            "type": "string",
            "pattern": "^OP\\d{3}$"
          },
          "input_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "output_ref": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "integer",
                "boolean",
                "null",
                "array"
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "operator_id": {
                  "const": "OP001"
                }
              },
              "required": [
                "operator_id"
              ]
            },
            "then": {
              "properties": {
                "input_refs": {
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^ZB\\d{3}$"
                  }
                },
                "parameters": {
                  "not": {
                    "required": [
                      "metric_id"
                    ]
                  },
                  "allOf": [
                    {
                      "oneOf": [
                        {
                          "required": [
                            "institution_id"
                          ],
                          "properties": {
                            "institution_id": {
                              "type": "string",
                              "pattern": "^ORG\\d{3}$"
                            }
                          },
                          "not": {
                            "required": [
                              "institution_ids"
                            ]
                          }
                        },
                        {
                          "required": [
                            "institution_ids"
                          ],
                          "properties": {
                            "institution_ids": {
                              "type": "array",
                              "minItems": 1,
                              "uniqueItems": true,
                              "items": {
                                "type": "string",
                                "pattern": "^ORG\\d{3}$"
                              }
                            }
                          },
                          "not": {
                            "required": [
                              "institution_id"
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "oneOf": [
                        {
                          "required": [
                            "date"
                          ],
                          "not": {
                            "anyOf": [
                              {
                                "required": [
                                  "dates"
                                ]
                              },
                              {
                                "required": [
                                  "start_date"
                                ]
                              },
                              {
                                "required": [
                                  "end_date"
                                ]
                              }
                            ]
                          }
                        },
                        {
                          "required": [
                            "dates"
                          ],
                          "not": {
                            "anyOf": [
                              {
                                "required": [
                                  "date"
                                ]
                              },
                              {
                                "required": [
                                  "start_date"
                                ]
                              },
                              {
                                "required": [
                                  "end_date"
                                ]
                              }
                            ]
                          }
                        },
                        {
                          "required": [
                            "start_date",
                            "end_date"
                          ],
                          "not": {
                            "anyOf": [
                              {
                                "required": [
                                  "date"
                                ]
                              },
                              {
                                "required": [
                                  "dates"
                                ]
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator_id": {
                  "const": "OP006"
                }
              },
              "required": [
                "operator_id"
              ]
            },
            "then": {
              "properties": {
                "input_refs": {
                  "minItems": 2,
                  "maxItems": 2
                },
                "parameters": {
                  "required": [
                    "numerator",
                    "denominator"
                  ],
                  "properties": {
                    "numerator": {
                      "type": "string"
                    },
                    "denominator": {
                      "type": "string"
                    },
                    "multiplier": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "result_unit": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator_id": {
                  "const": "OP007"
                }
              },
              "required": [
                "operator_id"
              ]
            },
            "then": {
              "properties": {
                "input_refs": {
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator_id": {
                  "const": "OP011"
                }
              },
              "required": [
                "operator_id"
              ]
            },
            "then": {
              "properties": {
                "parameters": {
                  "required": [
                    "order"
                  ],
                  "properties": {
                    "order": {
                      "type": "string",
