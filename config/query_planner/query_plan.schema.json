            },
            "digits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            }
          }
        },
        "tie_policy": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "preserve_all",
            "none",
            null
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "properties": {
              "code": {
                "const": "executable"
              }
