                "operator_id": {
                  "const": "OP006"
                }
              },
              "required": [
                "operator_id"
              ]
            }
          }
        },
        "required": [
          "operations"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "type": {
                      "const": "denominator_nonzero"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "minContains": 1
              }
            ]
          }
        },
        "required": [
          "checks"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operations": {
            "contains": {
              "properties": {
                "operator_id": {
                  "const": "OP007"
                }
              },
              "required": [
                "operator_id"
              ]
            }
          }
        },
        "required": [
          "operations"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "type": {
                      "const": "denominator_nonzero"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "minContains": 1
              }
            ]
          }
        },
        "required": [
          "checks"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operations": {
            "contains": {
              "properties": {
                "operator_id": {
                  "const": "OP009"
                }
              },
              "required": [
                "operator_id"
              ]
            }
          }
        },
        "required": [
          "operations"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "allOf": [
              {
                "contains": {
